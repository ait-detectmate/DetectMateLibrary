{
  "chain": "C3",
  "dataset": "audit.log",
  "detector": "LogBertDetector",
  "parser": {
    "log_format": "type=<Type> msg=audit(<Time>): <Content>",
    "time_format": null,
    "params": {
      "remove_spaces": true,
      "remove_punctuation": true,
      "lowercase": true
    }
  },
  "config": {
    "method_type": "logbert_detector",
    "auto_config": false,
    "data_use_training": 1800,
    "window_size": 10,
    "hyperparameters": {
      "Model": {
        "hidden": 256,
        "num_heads": 2,
        "n_layers": 4,
        "dropout": 0.0,
        "max_len": 1000
      },
      "Train": {
        "seed": 0,
        "batch_size": 256,
        "learning_rate": 0.01,
        "epochs": 10,
        "mask_per": 0.4,
        "alpha": 0.0,
        "patience": 3
      },
      "Finetune": []
    }
  },
  "measured": {
    "labelled_found": [
      "1859",
      "1860",
      "1861",
      "1862",
      "1863",
      "1864",
      "1865",
      "1866",
      "1867"
    ],
    "false_alarms": [
      "1856",
      "1857",
      "1858",
      "1868",
      "1869",
      "1870",
      "1871"
    ]
  },
  "min_labelled_found": 8,
  "max_false_alarms": 10,
  "regenerate": "uv run pytest tests/e2e -m '' --update-golden"
}
